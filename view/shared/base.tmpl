<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{block "title" .}}DistroHub{{end}}</title>
    <link rel="stylesheet" href="/public/css/base.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<script defer src="/public/js/base.js"></script>
    <style>
     @view-transition {
       navigation: auto;
     }
    </style>
		{{ block "style" . }} {{ end }}
  </head>
  <body>
    <header class="header">
      <a class="logo" href="/">DistroHub</a>
			<div class="header_search">
				<input type="search" placeholder="Search..." />
			</div>
      <nav role="navigation">
        <ul>
          <li><a href="/packages">packages</a></li>
          <li><a href="/waiting-list">waiting list</a></li>
          <li><button class="btn">Add new distro</button></li>
        </ul>
      </nav>
			<div class="mob_nav">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
			</div>
    </header>
    <main>
      {{block "content" .}}
        <span>No content, come back later ...</span>
      {{end}}
    </main>

		{{ block "script" . }} {{ end }}
  </body>
</html>
